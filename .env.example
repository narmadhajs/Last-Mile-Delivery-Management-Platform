# =================================================================
# Last-Mile Delivery Tracker - Environment Configuration Template
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret for Role-based Authentication
JWT_SECRET="super-secret-logitrack-jwt-token-2026"
JWT_EXPIRES_IN="7d"

# Default Logistics Configuration
DEFAULT_VOLUMETRIC_DIVISOR=5000
MAX_AGENT_CONCURRENT_ORDERS=5
AUTO_ASSIGNMENT_RADIUS_KM=25

# Email & SMS Notification Simulation / Provider (Optional SMTP / Twilio)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER="simulation"
ENABLE_REAL_NOTIFICATIONS=false
